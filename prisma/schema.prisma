// ZPROO GO — PostgreSQL schema
//
// Conventions
// - Tables and columns are snake_case in the database (@@map / @map), camelCase in code.
// - Primary keys are cuid strings (non-enumerable).
// - Money is stored as integer minor units (paise) — never floats.
// - `deleted_at` marks soft-deleted rows; queries must filter on it.
//
// Phase 1 contains the identity and platform models. Each later phase adds its domain
// models through a new migration (see docs/DATABASE.md).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_DATABASE_URL")
}

// ─────────────────────────────── Enums ───────────────────────────────

enum RoleName {
  USER
  ADMIN
  SUPER_ADMIN
  SUPPORT
  OPERATOR
  DRIVER
  HOTEL_PARTNER
  TRAVEL_PARTNER
  CORPORATE_ADMIN
}

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum OtpPurpose {
  SIGNUP
  LOGIN
  PASSWORD_RESET
  CONTACT_VERIFICATION
}

enum OtpChannel {
  SMS
  EMAIL
  WHATSAPP
}

enum AuthProvider {
  GOOGLE
  APPLE
}

enum ServiceType {
  FLIGHT
  BUS
  TRAIN
  HOTEL
  CAB
  BIKE
  HOLIDAY
  PARCEL
  CORPORATE
}

enum BookingStatus {
  INITIATED
  PENDING_PAYMENT
  /// Paid; waiting for the supplier to confirm the reservation (trains book after payment).
  PROCESSING
  CONFIRMED
  CANCELLED
  COMPLETED
  REFUND_PENDING
  REFUNDED
}

enum PaymentStatus {
  CREATED
  PENDING
  AUTHORIZED
  SUCCESS
  FAILED
  REFUNDED
  PARTIALLY_REFUNDED
  CANCELLED
}

enum CabinClass {
  ECONOMY
  PREMIUM_ECONOMY
  BUSINESS
  FIRST
}

enum PassengerType {
  ADULT
  CHILD
  INFANT
}

enum Gender {
  MALE
  FEMALE
  OTHER
}

enum BusType {
  SEATER
  SLEEPER
  SEATER_SLEEPER
}

enum BusDeck {
  LOWER
  UPPER
}

enum BusSeatKind {
  SEATER
  SLEEPER
}

enum BusPointKind {
  BOARDING
  DROPPING
}

/// Where a train reservation stands with the railway provider.
enum TrainReservationStatus {
  PENDING
  BOOKED
  FAILED
  CANCELLED
  PARTIALLY_CANCELLED
}

enum TrainPassengerStatus {
  PENDING
  CONFIRMED
  RAC
  WAITLIST
  CANCELLED
}

enum TrainCancellationStatus {
  REQUESTED
  COMPLETED
  FAILED
}

enum RefundStatus {
  REQUESTED
  PROCESSING
  COMPLETED
  FAILED
}

// ────────────────────────────── Identity ─────────────────────────────

model User {
  id              String     @id @default(cuid())
  /// E.164, e.g. +919876543210
  phone           String?    @unique
  /// Stored lower-cased.
  email           String?    @unique
  /// argon2id hash; null for OTP/social-only accounts.
  passwordHash    String?    @map("password_hash")
  fullName        String     @map("full_name")
  avatarUrl       String?    @map("avatar_url")
  dateOfBirth     DateTime?  @map("date_of_birth") @db.Date
  gender          Gender?
  state           String?
  status          UserStatus @default(ACTIVE)
  phoneVerifiedAt DateTime?  @map("phone_verified_at")
  emailVerifiedAt DateTime?  @map("email_verified_at")
  lastLoginAt     DateTime?  @map("last_login_at")
  createdAt       DateTime   @default(now()) @map("created_at")
  updatedAt       DateTime   @updatedAt @map("updated_at")
  deletedAt       DateTime?  @map("deleted_at")

  roles          UserRole[]      @relation("UserRoles")
  rolesAssigned  UserRole[]      @relation("RoleAssigner")
  refreshTokens  RefreshToken[]
  otpCodes       OtpCode[]
  identities     AuthIdentity[]
  addresses      Address[]
  auditLogs      AuditLog[]
  settingsEdited SystemSetting[]
  bookings       Booking[]
  payments       Payment[]

  @@index([status])
  @@index([createdAt])
  @@map("users")
}

model Role {
  id          String   @id @default(cuid())
  name        RoleName @unique
  description String?
  /// System roles are created by the seed and cannot be deleted.
  isSystem    Boolean  @default(true) @map("is_system")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  users       UserRole[]
  permissions RolePermission[]

  @@map("roles")
}

model Permission {
  id          String   @id @default(cuid())
  /// `resource:action[:scope]`, e.g. `booking:read:any`
  key         String   @unique
  description String?
  createdAt   DateTime @default(now()) @map("created_at")

  roles RolePermission[]

  @@map("permissions")
}

model UserRole {
  userId       String   @map("user_id")
  roleId       String   @map("role_id")
  assignedById String?  @map("assigned_by_id")
  assignedAt   DateTime @default(now()) @map("assigned_at")

  user       User  @relation("UserRoles", fields: [userId], references: [id], onDelete: Cascade)
  role       Role  @relation(fields: [roleId], references: [id], onDelete: Cascade)
  assignedBy User? @relation("RoleAssigner", fields: [assignedById], references: [id], onDelete: SetNull)

  @@id([userId, roleId])
  @@index([roleId])
  @@map("user_roles")
}

model RolePermission {
  roleId       String @map("role_id")
  permissionId String @map("permission_id")

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@index([permissionId])
  @@map("role_permissions")
}

/// Opaque refresh tokens, stored as SHA-256 hashes. Rotated on every use; reuse of a
/// rotated token revokes the whole family.
model RefreshToken {
  id           String    @id @default(cuid())
  userId       String    @map("user_id")
  tokenHash    String    @unique @map("token_hash")
  familyId     String    @map("family_id")
  expiresAt    DateTime  @map("expires_at")
  revokedAt    DateTime? @map("revoked_at")
  replacedById String?   @unique @map("replaced_by_id")
  ipAddress    String?   @map("ip_address")
  userAgent    String?   @map("user_agent")
  createdAt    DateTime  @default(now()) @map("created_at")

  user       User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  replacedBy RefreshToken? @relation("TokenRotation", fields: [replacedById], references: [id], onDelete: SetNull)
  replaces   RefreshToken? @relation("TokenRotation")

  @@index([userId])
  @@index([familyId])
  @@index([expiresAt])
  @@map("refresh_tokens")
}

/// One-time passwords. Only a hash of the code is stored.
model OtpCode {
  id          String     @id @default(cuid())
  /// Phone (E.164) or lower-cased email the code was sent to.
  target      String
  channel     OtpChannel
  purpose     OtpPurpose
  codeHash    String     @map("code_hash")
  attempts    Int        @default(0)
  maxAttempts Int        @default(5) @map("max_attempts")
  expiresAt   DateTime   @map("expires_at")
  consumedAt  DateTime?  @map("consumed_at")
  userId      String?    @map("user_id")
  ipAddress   String?    @map("ip_address")
  createdAt   DateTime   @default(now()) @map("created_at")

  user User? @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([target, purpose, createdAt])
  @@index([expiresAt])
  @@map("otp_codes")
}

/// Linked social logins (Google, Apple).
model AuthIdentity {
  id             String       @id @default(cuid())
  userId         String       @map("user_id")
  provider       AuthProvider
  providerUserId String       @map("provider_user_id")
  email          String?
  createdAt      DateTime     @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerUserId])
  @@index([userId])
  @@map("auth_identities")
}

model Address {
  id         String    @id @default(cuid())
  userId     String    @map("user_id")
  label      String
  line1      String
  line2      String?
  landmark   String?
  city       String
  state      String
  postalCode String    @map("postal_code")
  /// ISO 3166-1 alpha-2
  country    String    @default("IN") @db.Char(2)
  latitude   Float?
  longitude  Float?
  isDefault  Boolean   @default(false) @map("is_default")
  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @updatedAt @map("updated_at")
  deletedAt  DateTime? @map("deleted_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("addresses")
}

// ────────────────────────────── Platform ─────────────────────────────

/// Append-only record of security-relevant and administrative actions.
model AuditLog {
  id         String   @id @default(cuid())
  actorId    String?  @map("actor_id")
  action     String
  entityType String   @map("entity_type")
  entityId   String?  @map("entity_id")
  before     Json?
  after      Json?
  ipAddress  String?  @map("ip_address")
  userAgent  String?  @map("user_agent")
  requestId  String?  @map("request_id")
  createdAt  DateTime @default(now()) @map("created_at")

  actor User? @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([entityType, entityId])
  @@index([actorId, createdAt])
  @@index([createdAt])
  @@map("audit_logs")
}

/// Runtime-configurable settings managed from the admin panel.
model SystemSetting {
  key         String   @id
  value       Json
  description String?
  updatedById String?  @map("updated_by_id")
  updatedAt   DateTime @updatedAt @map("updated_at")

  updatedBy User? @relation(fields: [updatedById], references: [id], onDelete: SetNull)

  @@map("system_settings")
}

// ────────────────────────────── Flights ──────────────────────────────

model Airline {
  id        String   @id @default(cuid())
  /// IATA designator, e.g. "SF"
  code      String   @unique
  name      String
  active    Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at")

  flights  Flight[]
  segments FlightSegment[]

  @@map("airlines")
}

model Airport {
  id        String @id @default(cuid())
  /// IATA code, e.g. "PNQ"
  code      String @unique
  name      String
  city      String
  country   String
  /// IANA time zone, e.g. "Asia/Kolkata" — schedules are local to the airport.
  timezone  String
  latitude  Float?
  longitude Float?

  departures        Flight[]        @relation("FlightOrigin")
  arrivals          Flight[]        @relation("FlightDestination")
  segmentDepartures FlightSegment[] @relation("SegmentOrigin")
  segmentArrivals   FlightSegment[] @relation("SegmentDestination")

  @@map("airports")
}

/// A scheduled service in the development (mock) flight provider. Real providers return
/// offers directly; this table is the mock's timetable.
model Flight {
  id            String   @id @default(cuid())
  airlineId     String   @map("airline_id")
  /// Marketing flight number of the journey, e.g. "SF 2135"
  flightNumber  String   @map("flight_number")
  originId      String   @map("origin_id")
  destinationId String   @map("destination_id")
  /// ISO weekdays the service operates (1 = Monday … 7 = Sunday)
  daysOfWeek    Int[]    @map("days_of_week")
  /// Economy base fare per adult in paise before demand pricing
  baseFarePaise Int      @map("base_fare_paise")
  seatsEconomy  Int      @map("seats_economy")
  seatsPremium  Int      @default(0) @map("seats_premium")
  seatsBusiness Int      @default(0) @map("seats_business")
  seatsFirst    Int      @default(0) @map("seats_first")
  aircraft      String
  active        Boolean  @default(true)
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  airline     Airline           @relation(fields: [airlineId], references: [id])
  origin      Airport           @relation("FlightOrigin", fields: [originId], references: [id])
  destination Airport           @relation("FlightDestination", fields: [destinationId], references: [id])
  segments    FlightSegment[]
  inventory   FlightInventory[]

  @@unique([airlineId, flightNumber])
  @@index([originId, destinationId, active])
  @@map("flights")
}

/// One take-off and landing of a scheduled service. Non-stop services have one segment.
model FlightSegment {
  id              String @id @default(cuid())
  flightId        String @map("flight_id")
  sequence        Int
  airlineId       String @map("airline_id")
  flightNumber    String @map("flight_number")
  originId        String @map("origin_id")
  destinationId   String @map("destination_id")
  /// Local departure time at the segment origin, "HH:MM"
  departureTime   String @map("departure_time")
  /// Whole days after the journey's first departure date (0 = same day)
  dayOffset       Int    @default(0) @map("day_offset")
  durationMinutes Int    @map("duration_minutes")

  flight      Flight  @relation(fields: [flightId], references: [id], onDelete: Cascade)
  airline     Airline @relation(fields: [airlineId], references: [id])
  origin      Airport @relation("SegmentOrigin", fields: [originId], references: [id])
  destination Airport @relation("SegmentDestination", fields: [destinationId], references: [id])

  @@unique([flightId, sequence])
  @@map("flight_segments")
}

/// Seats sold per service, date and cabin. Updated with a conditional increment so two
/// bookings can never oversell the last seats.
model FlightInventory {
  id       String     @id @default(cuid())
  flightId String     @map("flight_id")
  date     DateTime   @db.Date
  cabin    CabinClass
  capacity Int
  sold     Int        @default(0)

  flight Flight @relation(fields: [flightId], references: [id], onDelete: Cascade)

  @@unique([flightId, date, cabin])
  @@map("flight_inventory")
}

// ────────────────────────────── Bookings ─────────────────────────────

model Booking {
  id                  String        @id @default(cuid())
  /// Customer-facing reference, ZP-YYYY-XXXXXX
  reference           String        @unique
  userId              String        @map("user_id")
  serviceType         ServiceType   @map("service_type")
  status              BookingStatus @default(INITIATED)
  paymentStatus       PaymentStatus @default(CREATED) @map("payment_status")
  currency            String        @default("INR") @db.Char(3)
  baseAmountPaise     Int           @map("base_amount_paise")
  taxAmountPaise      Int           @map("tax_amount_paise")
  feeAmountPaise      Int           @default(0) @map("fee_amount_paise")
  discountAmountPaise Int           @default(0) @map("discount_amount_paise")
  totalAmountPaise    Int           @map("total_amount_paise")
  contactEmail        String        @map("contact_email")
  contactPhone        String        @map("contact_phone")
  travelDate          DateTime      @map("travel_date") @db.Date
  /// Seats/rooms are held until this time; unpaid bookings are then cancelled.
  holdExpiresAt       DateTime?     @map("hold_expires_at")
  confirmedAt         DateTime?     @map("confirmed_at")
  cancelledAt         DateTime?     @map("cancelled_at")
  cancellationReason  String?       @map("cancellation_reason")
  /// Client-supplied Idempotency-Key; retries of the same request return the same booking.
  idempotencyKey      String?       @map("idempotency_key")
  metadata            Json?
  createdAt           DateTime      @default(now()) @map("created_at")
  updatedAt           DateTime      @updatedAt @map("updated_at")

  user       User               @relation(fields: [userId], references: [id])
  passengers BookingPassenger[]
  flights    FlightBooking[]
  bus        BusBooking?
  busSeats   BusSeatBooking[]
  train      TrainBooking?
  payments   Payment[]
  refunds    Refund[]

  @@unique([userId, idempotencyKey])
  @@index([userId, createdAt])
  @@index([status, holdExpiresAt])
  @@index([serviceType, travelDate])
  @@map("bookings")
}

model BookingPassenger {
  id          String        @id @default(cuid())
  bookingId   String        @map("booking_id")
  sequence    Int
  type        PassengerType
  title       String
  firstName   String        @map("first_name")
  lastName    String        @map("last_name")
  dateOfBirth DateTime?     @map("date_of_birth") @db.Date
  /// Age in years on the travel date (buses ask for age rather than date of birth).
  age         Int?
  gender      Gender
  /// Bus/train seat assigned to this traveller.
  seatNumber  String?       @map("seat_number")

  booking Booking         @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  train   TrainPassenger?

  @@unique([bookingId, sequence])
  @@map("booking_passengers")
}

/// One flown journey (leg) of a flight booking, with a snapshot of the offer as sold.
model FlightBooking {
  id              String     @id @default(cuid())
  bookingId       String     @map("booking_id")
  sequence        Int
  provider        String
  offerId         String     @map("offer_id")
  /// Mock provider only: the scheduled service and date whose inventory was used.
  flightId        String?    @map("flight_id")
  serviceDate     DateTime?  @map("service_date") @db.Date
  cabin           CabinClass
  seats           Int
  originCode      String     @map("origin_code")
  destinationCode String     @map("destination_code")
  departureAt     DateTime   @map("departure_at")
  arrivalAt       DateTime   @map("arrival_at")
  /// Offer as sold: airline, segments, fares, baggage, fare rules.
  offer           Json
  /// Airline booking reference, set on confirmation.
  pnr             String?
  /// [{ passengerId, ticketNumber }], set on confirmation.
  tickets         Json?

  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@unique([bookingId, sequence])
  @@index([flightId, serviceDate])
  @@map("flight_bookings")
}

// ────────────────────────────── Buses ─────────────────────────────

model BusOperator {
  id          String   @id @default(cuid())
  /// Short code used in service numbers, e.g. "SSK"
  code        String   @unique
  name        String
  /// Average customer rating, 1.0–5.0
  rating      Float
  ratingCount Int      @map("rating_count")
  active      Boolean  @default(true)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  buses Bus[]

  @@map("bus_operators")
}

/// A coach and its seat layout. Seats are booked per trip (BusSeatBooking), never on the bus.
model Bus {
  id         String   @id @default(cuid())
  operatorId String   @map("operator_id")
  /// Operator's own key for the coach, unique per operator
  code       String
  /// Display name, e.g. "Volvo 9600 Multi-Axle A/C Sleeper (2+1)"
  name       String
  type       BusType
  ac         Boolean
  electric   Boolean  @default(false)
  amenities  String[]
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  operator  BusOperator   @relation(fields: [operatorId], references: [id])
  seats     BusSeat[]
  schedules BusSchedule[]

  @@unique([operatorId, code])
  @@map("buses")
}

model BusSeat {
  id          String      @id @default(cuid())
  busId       String      @map("bus_id")
  /// Printed seat number, e.g. "L4" or "U12" or "17"
  number      String
  deck        BusDeck
  row         Int
  column      Int
  kind        BusSeatKind
  /// Seat price relative to the trip fare, in percent (lower sleepers cost more)
  farePercent Int         @default(100) @map("fare_percent")
  /// Reserved for women travellers
  ladiesOnly  Boolean     @default(false) @map("ladies_only")

  bus      Bus              @relation(fields: [busId], references: [id], onDelete: Cascade)
  bookings BusSeatBooking[]

  @@unique([busId, number])
  @@map("bus_seats")
}

/// City pair served by bus, with its boarding and dropping points. Cities are codes from
/// @zproo/config (e.g. "pune").
model BusRoute {
  id              String   @id @default(cuid())
  originCity      String   @map("origin_city")
  destinationCity String   @map("destination_city")
  distanceKm      Int      @map("distance_km")
  createdAt       DateTime @default(now()) @map("created_at")

  points    BusRoutePoint[]
  schedules BusSchedule[]

  @@unique([originCity, destinationCity])
  @@map("bus_routes")
}

model BusRoutePoint {
  id            String       @id @default(cuid())
  routeId       String       @map("route_id")
  kind          BusPointKind
  sequence      Int
  name          String
  address       String
  /// Boarding: minutes after departure. Dropping: minutes before arrival.
  offsetMinutes Int          @map("offset_minutes")

  route BusRoute @relation(fields: [routeId], references: [id], onDelete: Cascade)

  @@unique([routeId, kind, sequence])
  @@map("bus_route_points")
}

/// A regular service: this bus runs this route at this time on these days.
model BusSchedule {
  id              String   @id @default(cuid())
  busId           String   @map("bus_id")
  routeId         String   @map("route_id")
  /// Service number shown to customers, e.g. "SSK 2130"
  serviceNumber   String   @unique @map("service_number")
  /// Local (IST) departure time from the first boarding point, "HH:MM"
  departureTime   String   @map("departure_time")
  durationMinutes Int      @map("duration_minutes")
  /// ISO weekdays the service operates (1 = Monday … 7 = Sunday)
  daysOfWeek      Int[]    @map("days_of_week")
  /// Base fare per seat in paise before demand pricing and seat premiums
  baseFarePaise   Int      @map("base_fare_paise")
  active          Boolean  @default(true)
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  bus   Bus       @relation(fields: [busId], references: [id])
  route BusRoute  @relation(fields: [routeId], references: [id])
  trips BusTrip[]

  @@index([routeId, active])
  @@map("bus_schedules")
}

/// One departure of a schedule on a date. Created on first booking.
model BusTrip {
  id         String   @id @default(cuid())
  scheduleId String   @map("schedule_id")
  date       DateTime @db.Date

  schedule BusSchedule      @relation(fields: [scheduleId], references: [id], onDelete: Cascade)
  seats    BusSeatBooking[]

  @@unique([scheduleId, date])
  @@map("bus_trips")
}

/// A seat held or sold on a trip. The unique (trip, seat) pair makes double-booking impossible;
/// rows are deleted when a hold expires or a booking is cancelled.
model BusSeatBooking {
  id        String   @id @default(cuid())
  tripId    String   @map("trip_id")
  seatId    String   @map("seat_id")
  bookingId String   @map("booking_id")
  createdAt DateTime @default(now()) @map("created_at")

  trip    BusTrip @relation(fields: [tripId], references: [id], onDelete: Cascade)
  seat    BusSeat @relation(fields: [seatId], references: [id])
  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@unique([tripId, seatId])
  @@index([bookingId])
  @@map("bus_seat_bookings")
}

/// The bus journey of a booking, with a snapshot of the trip as sold.
model BusBooking {
  id              String   @id @default(cuid())
  bookingId       String   @unique @map("booking_id")
  provider        String
  offerId         String   @map("offer_id")
  /// Mock provider only: the trip whose seats were used.
  tripId          String?  @map("trip_id")
  operatorName    String   @map("operator_name")
  originCity      String   @map("origin_city")
  destinationCity String   @map("destination_city")
  departureAt     DateTime @map("departure_at")
  arrivalAt       DateTime @map("arrival_at")
  seatNumbers     String[] @map("seat_numbers")
  /// { id, name, address, time } chosen by the customer
  boardingPoint   Json     @map("boarding_point")
  droppingPoint   Json     @map("dropping_point")
  /// Trip as sold: operator, bus, amenities, fares, policies.
  offer           Json
  /// Operator's ticket/PNR number, set on confirmation.
  pnr             String?

  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@index([tripId])
  @@map("bus_bookings")
}

// ────────────────────────────── Trains ─────────────────────────────
// Railway providers own trains, schedules and inventory; these tables keep what was sold.
// Class ("3A") and quota ("GN") are provider codes stored as text — class codes start with a
// digit, so they cannot be Prisma enum values; the API validates them.

/// Seats this deployment has sold per train run, class and quota. Development (mock) provider
/// only — a real railway system keeps its own inventory. Updated with a conditional increment so
/// concurrent bookings never sell past the waiting list.
model TrainInventory {
  id          String   @id @default(cuid())
  trainNumber String   @map("train_number")
  /// Date the train leaves its first station
  runDate     DateTime @map("run_date") @db.Date
  travelClass String   @map("travel_class")
  quota       String
  sold        Int      @default(0)
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@unique([trainNumber, runDate, travelClass, quota])
  @@map("train_inventory")
}

/// The train journey of a booking: what was sold, and the reservation as the provider reports it.
model TrainBooking {
  id                String                 @id @default(cuid())
  bookingId         String                 @unique @map("booking_id")
  provider          String
  offerId           String                 @map("offer_id")
  trainNumber       String                 @map("train_number")
  trainName         String                 @map("train_name")
  fromStation       String                 @map("from_station")
  toStation         String                 @map("to_station")
  /// Boarding date (IST)
  journeyDate       DateTime               @map("journey_date") @db.Date
  departureAt       DateTime               @map("departure_at")
  arrivalAt         DateTime               @map("arrival_at")
  travelClass       String                 @map("travel_class")
  quota             String
  confirmOnly       Boolean                @default(false) @map("confirm_only")
  reservationStatus TrainReservationStatus @default(PENDING) @map("reservation_status")
  /// Railway PNR, set only when the provider issues one
  pnr               String?
  /// Provider's transaction id (used to reconcile a booking whose outcome is unknown)
  providerReference String?                @map("provider_reference")
  chartStatus       String?                @map("chart_status")
  failureReason     String?                @map("failure_reason")
  /// Calls made to the provider for this booking (booking and status checks)
  attempts          Int                    @default(0)
  lastCheckedAt     DateTime?              @map("last_checked_at")
  /// Per-passenger fare as quoted { basePaise, reservationPaise, superfastPaise, tatkalPaise, gstPaise, totalPaise }
  fare              Json
  /// Train as sold (the booked class only)
  offer             Json
  createdAt         DateTime               @default(now()) @map("created_at")
  updatedAt         DateTime               @updatedAt @map("updated_at")

  booking       Booking             @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  passengers    TrainPassenger[]
  cancellations TrainCancellation[]

  @@unique([provider, pnr])
  @@index([reservationStatus, lastCheckedAt])
  @@index([trainNumber, journeyDate])
  @@map("train_bookings")
}

/// Railway details of one passenger. Name, age and gender live on BookingPassenger.
model TrainPassenger {
  id                 String               @id @default(cuid())
  trainBookingId     String               @map("train_booking_id")
  bookingPassengerId String               @unique @map("booking_passenger_id")
  sequence           Int
  berthPreference    String               @map("berth_preference")
  foodChoice         String?              @map("food_choice")
  status             TrainPassengerStatus @default(PENDING)
  /// Status when booked, as reported by the provider, e.g. "CNF/B2/34/LOWER" or "GNWL 12"
  bookingStatus      String?              @map("booking_status")
  /// Latest status reported by the provider
  currentStatus      String?              @map("current_status")
  coach              String?
  berth              String?
  berthType          String?              @map("berth_type")
  farePaise          Int                  @map("fare_paise")
  cancelledAt        DateTime?            @map("cancelled_at")

  trainBooking     TrainBooking     @relation(fields: [trainBookingId], references: [id], onDelete: Cascade)
  bookingPassenger BookingPassenger @relation(fields: [bookingPassengerId], references: [id], onDelete: Cascade)

  @@unique([trainBookingId, sequence])
  @@map("train_passengers")
}

/// A request to cancel some or all passengers. Retries with the same Idempotency-Key return it.
model TrainCancellation {
  id                     String                  @id @default(cuid())
  trainBookingId         String                  @map("train_booking_id")
  idempotencyKey         String                  @map("idempotency_key")
  /// BookingPassenger ids being cancelled
  passengerIds           String[]                @map("passenger_ids")
  status                 TrainCancellationStatus @default(REQUESTED)
  chargesPaise           Int                     @map("charges_paise")
  refundPaise            Int                     @map("refund_paise")
  providerCancellationId String?                 @map("provider_cancellation_id")
  failureReason          String?                 @map("failure_reason")
  requestedById          String?                 @map("requested_by_id")
  completedAt            DateTime?               @map("completed_at")
  createdAt              DateTime                @default(now()) @map("created_at")

  trainBooking TrainBooking @relation(fields: [trainBookingId], references: [id], onDelete: Cascade)

  @@unique([trainBookingId, idempotencyKey])
  @@index([status])
  @@map("train_cancellations")
}

// ────────────────────────────── Payments ─────────────────────────────

model Payment {
  id                String        @id @default(cuid())
  bookingId         String        @map("booking_id")
  userId            String        @map("user_id")
  provider          String
  providerOrderId   String        @unique @map("provider_order_id")
  providerPaymentId String?       @unique @map("provider_payment_id")
  amountPaise       Int           @map("amount_paise")
  currency          String        @default("INR") @db.Char(3)
  status            PaymentStatus @default(CREATED)
  method            String?
  failureReason     String?       @map("failure_reason")
  capturedAt        DateTime?     @map("captured_at")
  createdAt         DateTime      @default(now()) @map("created_at")
  updatedAt         DateTime      @updatedAt @map("updated_at")

  booking Booking  @relation(fields: [bookingId], references: [id])
  user    User     @relation(fields: [userId], references: [id])
  refunds Refund[]

  @@index([bookingId])
  @@index([userId, createdAt])
  @@index([status])
  @@map("payments")
}

/// Money returned to the customer through the payment gateway. One row per cause (the unique
/// idempotency key), so a retried cancellation or reconciliation never refunds twice.
model Refund {
  id              String       @id @default(cuid())
  bookingId       String       @map("booking_id")
  paymentId       String       @map("payment_id")
  amountPaise     Int          @map("amount_paise")
  currency        String       @default("INR") @db.Char(3)
  status          RefundStatus @default(REQUESTED)
  /// Customer-facing reason, e.g. "Railway reservation failed" or "Cancellation of 2 passengers"
  reason          String
  /// e.g. "train-failed:<bookingId>" or "train-cancel:<cancellationId>"
  idempotencyKey  String       @unique @map("idempotency_key")
  /// Gateway refund id, once the gateway accepts the refund
  gatewayRefundId String?      @unique @map("gateway_refund_id")
  failureReason   String?      @map("failure_reason")
  completedAt     DateTime?    @map("completed_at")
  createdAt       DateTime     @default(now()) @map("created_at")
  updatedAt       DateTime     @updatedAt @map("updated_at")

  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  payment Payment @relation(fields: [paymentId], references: [id])

  @@index([bookingId])
  @@index([status, createdAt])
  @@map("refunds")
}
