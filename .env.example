# ZPROO GO environment template.
# Copy to `.env` at the repo root (`cp .env.example .env`) — the API, Prisma and the web app all read it.
# NEVER commit `.env`. See docs/ENVIRONMENT.md for every variable, and the phase that starts using it.

# ─────────────────────────────── API ───────────────────────────────
# NODE_ENV is not set here: tools choose it (Vite builds use production; the API defaults to
# development). Deployments set NODE_ENV=production in the environment.
PORT=5000
LOG_LEVEL=info

# PostgreSQL (local, Supabase or Neon). Supabase/Neon: DATABASE_URL = pooled URL, DIRECT_DATABASE_URL = direct URL.
DATABASE_URL=postgresql://zproo:zproo@localhost:5432/zproo_go?schema=public
DIRECT_DATABASE_URL=postgresql://zproo:zproo@localhost:5432/zproo_go?schema=public

REDIS_URL=redis://localhost:6379

FRONTEND_URL=http://localhost:5173
# Comma-separated browser origins allowed by CORS (defaults to FRONTEND_URL).
CORS_ORIGINS=http://localhost:5173
# Number of reverse proxies in front of the API (0 locally, usually 1 behind a load balancer).
TRUST_PROXY=0
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=300
# Swagger UI at /api/docs. Defaults to on outside production.
ENABLE_API_DOCS=true

# Auth. Required in production: 32+ random chars each, and different from each other.
# Left empty in development, the API generates throwaway secrets (sessions reset on restart).
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30
# Set when the web app and API are on different subdomains, e.g. .zproogo.com
COOKIE_DOMAIN=
# Social sign-in is enabled per provider when its client ID is set.
GOOGLE_OAUTH_CLIENT_ID=
APPLE_CLIENT_ID=

# SMS / OTP provider: console (development only — prints codes) | <vendor adapter>
SMS_PROVIDER=console
SMS_API_KEY=

# Travel suppliers (Phases 4–7): mock | <real adapter>
FLIGHT_PROVIDER=mock
BUS_PROVIDER=mock
# Railway: mock = invented demo trains & PNRs (refused in production). Live booking needs an
# authorised IRCTC partner adapter — see docs/RAILWAY_PROVIDER.md. Never put its credentials here in git.
TRAIN_PROVIDER=mock
TRAIN_PROVIDER_TIMEOUT_MS=15000
TRAIN_PROVIDER_RETRIES=2
# Platform fee per train booking, in paise (0 = none)
TRAIN_SERVICE_FEE_PAISE=0
HOTEL_PROVIDER=mock
# Minutes seats stay held for an unpaid booking (5–60)
BOOKING_HOLD_MINUTES=15
# Logo used on PDF tickets (optional; defaults to the web app's brand asset)
BRAND_LOGO_PATH=

# Maps (Phase 8): mock | google | mapbox
MAP_PROVIDER=mock
GOOGLE_MAPS_API_KEY=
MAPBOX_ACCESS_TOKEN=

# Payments: mock (development only — simulated gateway) | razorpay (Phase 14)
PAYMENT_PROVIDER=mock
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Email: console (development only) | smtp | resend (adapters arrive in Phase 16)
EMAIL_PROVIDER=console
EMAIL_FROM=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
RESEND_API_KEY=

# Encrypts partner API credentials at rest (Phase 18). 32 bytes, base64.
ENCRYPTION_KEY=

# ─────────────────────── Web (public — shipped to browsers, never put secrets here) ───────────────────────
# static (default): the website runs on its own with demo data. api: use the ZPROO GO API below.
VITE_DATA_SOURCE=static
# Leave VITE_API_URL empty in development to use the Vite proxy (/api → http://localhost:5000).
VITE_API_URL=
# Absolute site URL used for canonical links and social cards.
VITE_SITE_URL=http://localhost:5173
# Same value as GOOGLE_OAUTH_CLIENT_ID; shows "Continue with Google" when set.
VITE_GOOGLE_CLIENT_ID=
# Browser-restricted keys only (HTTP-referrer locked).
VITE_GOOGLE_MAPS_KEY=
VITE_RAZORPAY_KEY_ID=

# Frontend UPI payee ID used to build the payment QR. Configure a real verified VPA for production.
VITE_UPI_ID="zproobus@upi"

# ─────────────────────────────── Website contact details ───────────────────────────────
# Verified customer-support mobile number shown on Contact, Support and the footer. Leave empty to hide it.
VITE_SUPPORT_PHONE=
# Optional: a form endpoint (e.g. https://formspree.io/f/xxxx) that receives Contact / Careers submissions.
# When empty, the forms open the visitor's email app with the message pre-filled.
VITE_FORM_ENDPOINT=
